<script lang="ts" setup>
import type { {{ $model_class }}Row, {{ $model_class }}SavePayload } from '#/features/{{ $module_slug }}/api/{{ $entity_kebab }}';

import { computed, ref } from 'vue';

import { useVbenDrawer, useVbenModal } from '@vben/common-ui';
import { $t } from '@vben/locales';
import { usePreferences } from '@vben/preferences';
@if($has_datetime_form_fields || $has_date_form_fields)
import {
@if($has_date_form_fields)
  formatDateOnly,
@endif
@if($has_datetime_form_fields)
  formatDateTime,
@endif
} from '@vben/utils';
@endif

import { message } from 'ant-design-vue';
@if($has_picture_upload_fields)
import type { UploadFile } from 'ant-design-vue/es/upload';

import { uploadAttachment } from '#/features/system/api/attachment';
import { validateUploadFile } from '#/utils/upload-policy';
@endif

import { useVbenForm } from '#/adapter/form';
import { create{{ $model_class }}, update{{ $model_class }} } from '#/features/{{ $module_slug }}/api/{{ $entity_kebab }}';

import { build{{ $model_class }}FormSchema } from '../data';

const emits = defineEmits<{ success: [] }>();

const { isMobile } = usePreferences();

const editingId = ref<number | null>(null);
const readonly = ref(false);

@if($has_picture_upload_fields)
const singlePictureUploadFieldNames = [{{ $single_picture_upload_field_names_ts }}] as const;
@if($has_multi_picture_upload_fields)
const multiPictureUploadFieldNames = [{{ $multi_picture_upload_field_names_ts }}] as const;
@endif
@endif
@if($has_multi_attachment_fields)
const multiAttachmentFieldNames = [{{ $multi_attachment_field_names_ts }}] as const;
@endif
@if($has_multi_value_fields)
const multiValueFieldNames = [{{ $multi_value_field_names_ts }}] as const;
@endif
@if($has_datetime_form_fields)
const datetimeFormFieldNames = [{{ $datetime_form_field_names_ts }}] as const;
@endif
@if($has_date_form_fields)
const dateFormFieldNames = [{{ $date_form_field_names_ts }}] as const;
@endif

@if($has_picture_upload_fields)

function normalizeUploadToFileList(url?: null | string): UploadFile[] {
  if (!url) {
    return [];
  }
  return [
    {
      name: 'file',
      status: 'done',
      uid: 'upload-existing',
      url,
    },
  ];
}

function normalizeMultiUploadToFileList(value?: null | string): UploadFile[] {
  if (!value) {
    return [];
  }
  return value
    .split(',')
    .map((url) => url.trim())
    .filter(Boolean)
    .map((url, index) => ({
      name: `file-${index}`,
      status: 'done' as const,
      uid: `upload-existing-${index}`,
      url,
    }));
}

function resolveUploadUrl(files: unknown): string {
  const uploadFiles = Array.isArray(files) ? files : [];
  const file = uploadFiles[0] as
    | { response?: { file_url?: string }; url?: string }
    | undefined;
  if (!file) {
    return '';
  }
  return file.response?.file_url ?? file.url ?? '';
}

function resolveMultiUploadUrls(files: unknown): string {
  const uploadFiles = Array.isArray(files) ? files : [];
  return uploadFiles
    .map((file) => {
      const item = file as { response?: { file_url?: string }; url?: string };
      return item.response?.file_url ?? item.url ?? '';
    })
    .filter(Boolean)
    .join(',');
}

function onImageChange(_event: unknown) {}

async function onImageUpload(options: any) {
  const file = options?.file as File | undefined;
  if (!file) {
    options?.onError?.(new Error('missing file'));
    return;
  }
  const validationError = validateUploadFile(file, 'image');
  if (validationError) {
    message.error(validationError);
    options?.onError?.(new Error(validationError));
    return;
  }
  try {
    const row = await uploadAttachment(file);
    options?.onSuccess?.(row);
  } catch (error) {
    options?.onError?.(error);
    throw error;
  }
}

function buildSchema() {
  return build{{ $model_class }}FormSchema({
    readonly: readonly.value,
    onImageChange,
    onImageUpload,
  });
}
@else
function buildSchema() {
  return build{{ $model_class }}FormSchema({ readonly: readonly.value });
}
@endif

const [Form, formApi] = useVbenForm({
  commonConfig: {
    componentProps: { class: 'w-full' },
    labelClass: 'justify-start',
  },
  layout: 'vertical',
  schema: buildSchema(),
  showDefaultActions: false,
  wrapperClass: 'grid-cols-1 sm:grid-cols-2 gap-x-4 gap-y-1',
});

const formTitle = computed(() => {
  if (readonly.value) {
    return $t('{{ $i18n_prefix }}.form.viewTitle');
  }

  return editingId.value
    ? $t('{{ $i18n_prefix }}.form.editTitle')
    : $t('{{ $i18n_prefix }}.form.createTitle');
});

type PopupApi = {
  close: () => void;
  getData: <T = Record<string, never>>() => T;
  lock: () => void;
  open: () => void;
  setData: <T>(data: T) => void;
  unlock: () => void;
};

async function handleConfirm(popupApi: PopupApi) {
  if (readonly.value) {
    popupApi.close();
    return;
  }
  const { valid } = await formApi.validate();
  if (!valid) return;

  const values = (await formApi.getValues()) as Record<string, unknown>;
@if($has_picture_upload_fields)
  for (const fieldName of singlePictureUploadFieldNames) {
    if (fieldName in values) {
      values[fieldName] = resolveUploadUrl(values[fieldName]);
    }
  }
@if($has_multi_picture_upload_fields)
  for (const fieldName of multiPictureUploadFieldNames) {
    if (fieldName in values) {
      values[fieldName] = resolveMultiUploadUrls(values[fieldName]);
    }
  }
@endif
@endif
@if($has_multi_attachment_fields)
  for (const fieldName of multiAttachmentFieldNames) {
    const current = values[fieldName];
    if (Array.isArray(current)) {
      values[fieldName] = current.join(',');
    }
  }
@endif
@if($has_multi_value_fields)
  for (const fieldName of multiValueFieldNames) {
    const current = values[fieldName];
    if (Array.isArray(current)) {
      values[fieldName] = current.join(',');
    }
  }
@endif
  const payload = values as {{ $model_class }}SavePayload;
  popupApi.lock();
  try {
    if (!editingId.value) {
      await create{{ $model_class }}(payload);
      message.success($t('crud.created'));
    } else {
      await update{{ $model_class }}(editingId.value, payload);
      message.success($t('crud.saved'));
    }
    popupApi.close();
    emits('success');
  } finally {
    popupApi.unlock();
  }
}

async function handleOpenChange(isOpen: boolean, popupApi: PopupApi) {
  if (!isOpen) return;
  formApi.resetForm();
  const data = popupApi.getData<{{ $model_class }}Row | Record<string, never>>();
  const id = data && typeof (data as {{ $model_class }}Row).id === 'number' ? (data as {{ $model_class }}Row).id : null;
  editingId.value = id;
  readonly.value = false;
  formApi.setState({ schema: buildSchema() });
  if (id) {
@if($has_picture_upload_fields || $has_multi_attachment_fields || $has_multi_value_fields || $has_datetime_form_fields || $has_date_form_fields)
    const row = { ...(data as {{ $model_class }}Row) } as Record<string, unknown>;
@endif
@if($has_picture_upload_fields)
    for (const fieldName of singlePictureUploadFieldNames) {
      const value = row[fieldName];
      if (typeof value === 'string' && value) {
        row[fieldName] = normalizeUploadToFileList(value);
      }
    }
@if($has_multi_picture_upload_fields)
    for (const fieldName of multiPictureUploadFieldNames) {
      const value = row[fieldName];
      if (typeof value === 'string' && value) {
        row[fieldName] = normalizeMultiUploadToFileList(value);
      }
    }
@endif
@endif
@if($has_multi_attachment_fields)
    for (const fieldName of multiAttachmentFieldNames) {
      const value = row[fieldName];
      if (typeof value === 'string' && value) {
        row[fieldName] = value
          .split(',')
          .map((item) => item.trim())
          .filter(Boolean);
      }
    }
@endif
@if($has_multi_value_fields)
    for (const fieldName of multiValueFieldNames) {
      const value = row[fieldName];
      if (typeof value === 'string' && value) {
        row[fieldName] = value.split(',').filter(Boolean);
      }
    }
@endif
@if($has_datetime_form_fields)
    for (const fieldName of datetimeFormFieldNames) {
      const value = row[fieldName];
      if (typeof value === 'string' && value) {
        row[fieldName] = formatDateTime(value);
      }
    }
@endif
@if($has_date_form_fields)
    for (const fieldName of dateFormFieldNames) {
      const value = row[fieldName];
      if (typeof value === 'string' && value) {
        row[fieldName] = formatDateOnly(value);
      }
    }
@endif
@if($has_picture_upload_fields || $has_multi_attachment_fields || $has_multi_value_fields || $has_datetime_form_fields || $has_date_form_fields)
    formApi.setValues(row as {{ $model_class }}Row);
@else
    formApi.setValues(data as {{ $model_class }}Row);
@endif
  }
}

const [ModalView, modalApi] = useVbenModal({
  onConfirm: () => handleConfirm(modalApi),
  onOpenChange: (isOpen) => handleOpenChange(isOpen, modalApi),
});

const [DrawerView, drawerApi] = useVbenDrawer({
  onConfirm: () => handleConfirm(drawerApi),
  onOpenChange: (isOpen) => handleOpenChange(isOpen, drawerApi),
});

function open(data: {{ $model_class }}Row | Record<string, never> = {}) {
  const api = isMobile.value ? drawerApi : modalApi;
  api.setData(data);
  api.open();
}

defineExpose({ open });
</script>

<template>
@if($has_rich_editor)
  <ModalView v-if="!isMobile" :title="formTitle" class="w-[860px]">
@else
  <ModalView v-if="!isMobile" :title="formTitle" class="w-[640px]">
@endif
    <Form />
  </ModalView>
  <DrawerView v-else :title="formTitle" class="w-full">
    <Form />
  </DrawerView>
</template>
