<script lang="ts" setup>
import type { {{ $model_class }}Row, {{ $model_class }}SavePayload } from '#/api/system/{{ $entity_kebab }}';

import { computed, ref } from 'vue';

import { useVbenDrawer, useVbenModal } from '@vben/common-ui';
import { $t } from '@vben/locales';
import { usePreferences } from '@vben/preferences';

import { message } from 'ant-design-vue';

import { useVbenForm } from '#/adapter/form';
import { create{{ $model_class }}, update{{ $model_class }} } from '#/api/system/{{ $entity_kebab }}';

import { build{{ $model_class }}FormSchema } from '../data';

const emits = defineEmits<{ success: [] }>();

const { isMobile } = usePreferences();

const editingId = ref<number | null>(null);
const readonly = ref(false);

const [Form, formApi] = useVbenForm({
  commonConfig: {
    componentProps: { class: 'w-full' },
    labelClass: 'justify-start',
  },
  layout: 'vertical',
  schema: build{{ $model_class }}FormSchema(),
  showDefaultActions: false,
  wrapperClass: 'grid-cols-1 sm:grid-cols-2 gap-x-4 gap-y-1',
});

const formTitle = computed(() => {
  if (readonly.value) {
    return $t('{{ $i18n_prefix }}.form.viewTitle');
  }

  return editingId.value
    ? $t('{{ $i18n_prefix }}.form.editTitle')
    : $t('{{ $i18n_prefix }}.form.createTitle');
});

type PopupApi = {
  close: () => void;
  getData: <T = Record<string, never>>() => T;
  lock: () => void;
  open: () => void;
  setData: <T>(data: T) => void;
  unlock: () => void;
};

async function handleConfirm(popupApi: PopupApi) {
  if (readonly.value) {
    popupApi.close();
    return;
  }
  const { valid } = await formApi.validate();
  if (!valid) return;

  const values = (await formApi.getValues()) as {{ $model_class }}SavePayload;
  popupApi.lock();
  try {
    if (!editingId.value) {
      await create{{ $model_class }}(values);
      message.success($t('crud.created'));
    } else {
      await update{{ $model_class }}(editingId.value, values);
      message.success($t('crud.saved'));
    }
    popupApi.close();
    emits('success');
  } finally {
    popupApi.unlock();
  }
}

async function handleOpenChange(isOpen: boolean, popupApi: PopupApi) {
  if (!isOpen) return;
  formApi.resetForm();
  const data = popupApi.getData<{{ $model_class }}Row | Record<string, never>>();
  const id = data && typeof (data as {{ $model_class }}Row).id === 'number' ? (data as {{ $model_class }}Row).id : null;
  editingId.value = id;
  readonly.value = false;
  formApi.setState({ schema: build{{ $model_class }}FormSchema(false) });
  if (id) {
    formApi.setValues(data as {{ $model_class }}Row);
  }
}

const [ModalView, modalApi] = useVbenModal({
  onConfirm: () => handleConfirm(modalApi),
  onOpenChange: (isOpen) => handleOpenChange(isOpen, modalApi),
});

const [DrawerView, drawerApi] = useVbenDrawer({
  onConfirm: () => handleConfirm(drawerApi),
  onOpenChange: (isOpen) => handleOpenChange(isOpen, drawerApi),
});

function open(data: {{ $model_class }}Row | Record<string, never> = {}) {
  const api = isMobile.value ? drawerApi : modalApi;
  api.setData(data);
  api.open();
}

defineExpose({ open });
</script>

<template>
  <ModalView v-if="!isMobile" :title="formTitle" class="w-[640px]">
    <Form />
  </ModalView>
  <DrawerView v-else :title="formTitle" class="w-full">
    <Form />
  </DrawerView>
</template>
