import type { LaravelPaginate } from '#/api/system/types';

import { requestClient } from '#/api/request';

export interface {{ $model_class }}Row {
{!! $api_row_fields_body !!}
  created_at?: string;
  updated_at?: string;
}

export interface {{ $model_class }}PageQuery {
  page: number;
  per_page: number;
@if($has_keyword_search)
  keyword?: string;
@endif
{!! $api_page_query_fields_body !!}
  sort_field?: string;
  sort_order?: 'asc' | 'desc';
}

export interface {{ $model_class }}SavePayload {
{!! $api_save_payload_fields_body !!}
}

export function fetch{{ $model_class }}Page(params: {{ $model_class }}PageQuery) {
  return requestClient.get<LaravelPaginate<{{ $model_class }}Row>>('/{{ $api_route_prefix }}/{{ $api_prefix }}', {
    params,
  });
}

export function create{{ $model_class }}(data: {{ $model_class }}SavePayload) {
  return requestClient.post<{{ $model_class }}Row>('/{{ $api_route_prefix }}/{{ $api_prefix }}', data);
}

export function update{{ $model_class }}(id: number, data: Partial<{{ $model_class }}SavePayload>) {
  return requestClient.put<{{ $model_class }}Row>(`/{{ $api_route_prefix }}/{{ $api_prefix }}/${id}`, data);
}

export function delete{{ $model_class }}(id: number) {
  return requestClient.delete(`/{{ $api_route_prefix }}/{{ $api_prefix }}/${id}`);
}
@if($has_batch_delete)

export function batchDelete{{ $model_class }}s(ids: number[]) {
  return requestClient.post<{ deleted: number }>(
    '/{{ $api_route_prefix }}/{{ $api_prefix }}/batch-destroy',
    { ids },
  );
}
@endif
@if($has_batch_status)

export function batchUpdate{{ $model_class }}Status(ids: number[], status: 0 | 1) {
  return requestClient.put<{ updated: number }>('/{{ $api_route_prefix }}/{{ $api_prefix }}/batch-status', {
    ids,
    status,
  });
}
@endif
