import type { VbenFormSchema } from '#/adapter/form';
import type {
  CrudGridColumn,
  MobileCrudListConfig,
} from '#/adapter/mobile-list';
import { buildMobileCrudFromColumns } from '#/adapter/mobile-list';
import type { OnActionClickFn } from '#/adapter/vxe-table';

import type { {{ $model_class }}Row } from '#/features/{{ $module_slug }}/api/{{ $api_route_prefix }}/{{ $entity_kebab }}';

import { $t } from '#/locales';
import { formatDateTime } from '@vben/utils';

import { TABLE_CELL_EMPTY } from '#/constants/table';
import { {{ $permissions_export_name }} } from '#/features/{{ $module_slug }}/constants/{{ $entity_kebab }}-permissions';
@if($has_list_cell_helpers)
import {
  csvExtraCount,
  extractFileNameFromUrl,
  firstCsvValue,
  stripHtmlSummary,
} from '#/utils/list-cell';
@endif
@if($has_dict_fields)
import { DICT_TYPE_CODE, mapDictItemOptions } from '#/features/system/views/platform/dict/i18n';
@endif
@if($has_relation_fields)
{!! $relation_imports_body !!}
@endif

export type {{ $model_class }}AccessChecker = {
  can: (code: string) => boolean;
  canAny: (codes: string[]) => boolean;
};

export function useGridFormSchema(): VbenFormSchema[] {
  return [
{!! $grid_form_schema_body !!}
  ];
}

export function build{{ $model_class }}MobileCrudConfig(params: {
  columns: CrudGridColumn<{{ $model_class }}Row>[];
  query: MobileCrudListConfig<{{ $model_class }}Row>['query'];
}): MobileCrudListConfig<{{ $model_class }}Row> {
  return buildMobileCrudFromColumns({
    columns: params.columns,
    defaultPageSize: 20,
    query: params.query,
    rowKey: 'id',
    search: {
      filterSchema: useGridFormSchema(),
      keywordFields: [{{ $keyword_fields_ts }}],
      placeholder: $t('{{ $i18n_prefix }}.searchPlaceholder'),
    },
    selection: {
      enabled: true,
    },
  });
}

export function useColumns(
  onActionClick: OnActionClickFn<{{ $model_class }}Row>,
  onStatusBeforeChange: (newVal: {{ $model_class }}Row['status'], row: {{ $model_class }}Row) => Promise<boolean>,
  access: {{ $model_class }}AccessChecker,
): CrudGridColumn<{{ $model_class }}Row>[] {
  const canUpdate = access.can({{ $permissions_export_name }}.UPDATE);

  return [
    { align: 'center', fixed: 'left', type: 'checkbox', width: 48 },
{!! $list_columns_body !!}
    {
      align: 'center',
      cellRender: {
        attrs: {
          nameField: '{{ $primary_label_field }}',
          nameTitle: $t('{{ $i18n_prefix }}.title'),
          onClick: onActionClick,
        },
        name: 'CellOperation',
        options: [
          {
            code: 'edit',
            show: () => access.can({{ $permissions_export_name }}.UPDATE),
            text: $t('common.edit'),
            type: 'link',
          },
          {
            code: 'delete',
            danger: true,
            show: () => access.can({{ $permissions_export_name }}.DELETE),
            text: $t('common.delete'),
            type: 'link',
          },
        ],
      },
      fixed: 'right',
      title: $t('crud.columnActions'),
      width: 140,
    },
  ] as CrudGridColumn<{{ $model_class }}Row>[];
}

@if($has_relation_fields)
{!! $relation_loaders_body !!}
@endif

export type {{ $model_class }}FormSchemaParams = {
  readonly?: boolean;
@if($has_picture_upload_fields)
  onImageChange?: (event: unknown) => void;
  onImageUpload?: (options: unknown) => Promise<void> | void;
@endif
};

export function build{{ $model_class }}FormSchema(
  params: {{ $model_class }}FormSchemaParams = {},
): VbenFormSchema[] {
  const readonly = params.readonly ?? false;
  const disabled = readonly;
  return [
{!! $form_schema_body !!}
  ];
}
