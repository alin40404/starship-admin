        Route::get('{{ $api_prefix }}', [{{ $controller_class }}::class, 'index'])
            ->middleware('admin.permission:'.{{ $permissions_class }}::QUERY);
        Route::post('{{ $api_prefix }}', [{{ $controller_class }}::class, 'store'])
            ->middleware('admin.permission:'.{{ $permissions_class }}::CREATE);
@if($has_batch_delete)
        Route::post('{{ $api_prefix }}/batch-destroy', [{{ $controller_class }}::class, 'batchDestroy'])
            ->middleware('admin.permission:'.{{ $permissions_class }}::BATCH_DELETE);
@endif
@if($has_batch_status)
        Route::put('{{ $api_prefix }}/batch-status', [{{ $controller_class }}::class, 'batchUpdateStatus'])
            ->middleware('admin.permission:'.{{ $permissions_class }}::BATCH_STATUS);
