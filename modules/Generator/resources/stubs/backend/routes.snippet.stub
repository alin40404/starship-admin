        Route::get('{{ $api_prefix }}', [{{ $controller_fqcn }}::class, 'index'])
            ->middleware('admin.permission:{{ $permission_prefix }}.query');
        Route::post('{{ $api_prefix }}', [{{ $controller_fqcn }}::class, 'store'])
            ->middleware('admin.permission:{{ $permission_prefix }}.create');
