        Route::put('{{ $api_prefix }}/{id}', [{{ $controller_class }}::class, 'update'])
            ->middleware('admin.permission:'.{{ $permissions_class }}::UPDATE);
        Route::delete('{{ $api_prefix }}/{id}', [{{ $controller_class }}::class, 'destroy'])
            ->middleware('admin.permission:'.{{ $permissions_class }}::DELETE);
