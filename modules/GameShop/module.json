{
    "name": "game_shop",
    "title": "游戏商城",
    "version": "0.1.0",
    "enabled": true,
    "providers": [
        "Modules\\GameShop\\App\\Providers\\GameShopServiceProvider"
    ],
    "seeders": [
        "Modules\\GameShop\\Database\\Seeders\\GameShopMenuSeeder"
    ],
    "require": {
        "modules": [
            "system"
        ]
    },
    "menus": {
        "paths": [
            "/game-shop",
            "/game-shop/games",
            "/game-shop/products",
            "/game-shop/orders"
        ]
    },
    "permissions": {
        "prefixes": [
            "game_shop."
        ],
        "exact": []
    }
}
