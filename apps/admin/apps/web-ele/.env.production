VITE_BASE=/

# 生产环境请改为实际 API 根路径（需与 Laravel `admin-api` 前缀一致，可带域名）
# 例：https://api.example.com/admin-api
VITE_GLOB_API_URL=/admin-api

# 是否开启压缩，可以设置为 none, brotli, gzip
VITE_COMPRESS=none

# 是否开启 PWA
VITE_PWA=false

# vue-router 的模式
VITE_ROUTER_HISTORY=hash

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true

# 打包后是否生成dist.zip
VITE_ARCHIVER=true
