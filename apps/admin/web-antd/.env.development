# 端口号
VITE_PORT=5666

VITE_BASE=/

# Starship Laravel：与 apps/server 路由前缀一致（开发环境由 vite 代理到后端）
VITE_GLOB_API_URL=/admin-api

# 对接真实后端时请关闭 Mock
VITE_NITRO_MOCK=false

# 是否打开 devtools，true 为打开，false 为关闭
VITE_DEVTOOLS=false

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true

# Iconify 图标 CDN（可选，逗号分隔支持主备）
# 不填则使用官方 https://api.iconify.design
# 自有 CDN 需兼容 Iconify API 路径，例如：
#   GET https://cdn.example.com/iconify/lucide.json?icons=eye,info
# VITE_ICONIFY_API=https://cdn.example.com/iconify
# VITE_ICONIFY_API=https://cdn.example.com/iconify,https://api.iconify.design

# 插件前端 panel 仅按 slug 按需加载（默认 false：打开配置抽屉时预加载全部 panel）
# VITE_PLUGIN_FRONTEND_DYNAMIC_ENABLED=true
