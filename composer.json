{
    "name": "starship-admin/core",
    "description": "Starship Admin framework kernel — module scanner, plugin engine, theme manager, contracts",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "starship",
        "laravel",
        "admin",
        "module",
        "plugin",
        "theme"
    ],
    "authors": [
        {
            "name": "allanchan",
            "email": "alin40404@gmail.com"
        }
    ],
    "homepage": "https://github.com/alin40404/starship-core",
    "support": {
        "source": "https://github.com/alin40404/starship-core",
        "issues": "https://github.com/alin40404/starship-core/issues"
    },
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.0",
        "composer/composer": "^2.7"
    },
    "autoload": {
        "psr-4": {
            "Starship\\Core\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Starship\\Core\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "orchestra/testbench": "^11.1",
        "phpunit/phpunit": "^12.5.12"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Starship\\Core\\Providers\\CoreServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-master": "1.x-dev"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
