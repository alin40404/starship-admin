{
    "name": "starship/core",
    "description": "Starship Admin framework kernel — module scanner, plugin engine, contracts",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "allanchan",
            "email": "alin40404@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.0",
        "composer/composer": "^2.7"
    },
    "autoload": {
        "psr-4": {
            "Starship\\Core\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Starship\\Core\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "orchestra/testbench": "^11.1",
        "phpunit/phpunit": "^12.5.12"
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
