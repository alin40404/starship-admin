APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# 须与 Laravel 实际访问地址一致（php artisan serve 默认 8000），用于生成 /storage 附件 URL
APP_URL=http://127.0.0.1:8000

APP_LOCALE=zh_CN
APP_FALLBACK_LOCALE=zh_CN
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# 后台前端联调（CORS），逗号分隔；需包含 apps/admin 的 origin（如 http://localhost:5173）
# CORS_ALLOWED_ORIGINS=http://localhost:5777,http://127.0.0.1:5777,http://localhost:5173,http://127.0.0.1:5173

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=starship_admin
# DB_USERNAME=root
# DB_PASSWORD=
# DB_ENGINE=InnoDB
# 数据表前缀（Laravel database.connections.*.prefix，默认 sa_）
# DB_PREFIX=sa_

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# 管理端 SPA 地址（密码重置邮件链接等），默认与 APP_URL 相同
# ADMIN_FRONTEND_URL=http://localhost:5666

# 主题回退 slug：DB 无激活记录时 ThemeLoader / theme_asset() 等使用（默认 default）
# STARSHIP_DEFAULT_THEME=default
# 前台主题回退 slug：theme:link 等在无激活前台主题时使用（默认 default）
# STARSHIP_FRONTEND_THEME=default
# Theme/Plugin 静态资源 CDN（可选；未设时 theme_asset / plugin_asset 走 asset()/ASSET_URL）
# STARSHIP_ASSET_URL=https://cdn.example.com

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
